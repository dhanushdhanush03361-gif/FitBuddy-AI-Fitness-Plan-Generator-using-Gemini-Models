# FitBuddy Environment Configuration
# Add these variables in Vercel Project Settings -> Environment Variables or local .env

# Google Gemini API Key (Required for live AI generation)
# Get a key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model selection (Uses official current Gemini 2.5 Flash)
AI_PROVIDER=gemini
WORKOUT_MODEL=gemini-2.5-flash
FLASH_MODEL=gemini-2.5-flash

# Database configuration (defaults to SQLite /tmp on serverless)
DATABASE_URL=sqlite:///./fitbuddy.db

# Admin Dashboard Protection Token (required for /view-all-users)
ADMIN_TOKEN=fitbuddy-admin-secret-2026

# Environment mode ('development' or 'production')
ENVIRONMENT=production
